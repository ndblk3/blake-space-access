{
  "name": "blake-space-access",
  "version": "0.1.0",
  "description": "Witness who or what touched a personal space on disk — process, OS user, agent, or host — with a durable FS audit log. Companion to blake-policy-agent.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "blake-space-access": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "INTEGRATING.md",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "prepublishOnly": "npm test",
    "test": "npm run build && node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "private": false,
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndblk3/blake-space-access.git"
  },
  "bugs": {
    "url": "https://github.com/ndblk3/blake-space-access/issues"
  },
  "homepage": "https://bl4k3.com/space-access",
  "keywords": [
    "agents",
    "filesystem",
    "audit",
    "personal-space",
    "blake",
    "access-log",
    "witness"
  ],
  "author": "Blake / bl4k3.com",
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0"
  }
}
